---
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";

const capabilities = [
  "Private label production",
  "Precision sourcing",
  "Premium packaging",
  "Controlled quality assurance",
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Entrynor is a premium supplier and manufacturing partner for ambitious brands."
		/>
		<title>Entrynor — Premium Manufacturing Partner</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">Entrynor</a>
			<nav aria-label="Primary navigation">
				<a href="#capabilities">Capabilities</a>
				<a href="#standard">Standard</a>
				<a href="#contact">Contact</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<p class="eyebrow">Norwegian supplier · Global standards</p>
				<h1>Manufacturing for brands that cannot compromise.</h1>
				<p class="intro">
					Entrynor partners with selective companies to develop, source, and deliver premium products with quiet precision.
					No catalogue noise. No price chasing. Only carefully controlled supply for brands that value confidence.
				</p>
				<div class="hero-actions">
					<a class="button" href="#contact">Start a private conversation</a>
					<span>Discreet by design</span>
				</div>
			</section>

			<section id="capabilities" class="section split">
				<div>
					<p class="eyebrow">What we do</p>
					<h2>Exclusive production, handled end to end.</h2>
				</div>
				<div class="panel-grid">
					{capabilities.map((capability) => <article>{capability}</article>)}
				</div>
			</section>

			<section id="standard" class="section statement">
				<p>
					We work behind the scenes for demanding brands where presentation, consistency, and reliability matter. Our role is
					not to be loud. It is to make every delivered product feel inevitable.
				</p>
			</section>

			<section class="section proof">
				<div>
					<span>01</span>
					<h3>Selective</h3>
					<p>We choose partnerships carefully to protect quality, focus, and long-term trust.</p>
				</div>
				<div>
					<span>02</span>
					<h3>Controlled</h3>
					<p>Every detail is managed with clear standards, from specification to final delivery.</p>
				</div>
				<div>
					<span>03</span>
					<h3>Confidential</h3>
					<p>We respect the brands we serve and keep the spotlight where it belongs.</p>
				</div>
			</section>

			<section id="contact" class="section contact">
				<div class="contact-wrapper">
					<div>
						<p class="eyebrow">Private inquiries</p>
						<h2>For brands seeking a serious manufacturing partner.</h2>
						<p>
							Tell us what you are building, the standard you expect, and where reliability matters most. We will respond with
							discretion.
						</p>
					</div>
					<ContactForm />
				</div>
			</section>
		</main>

		<Footer email="contact@entrynor.no" phone="+47 XX XX XX XX" address="Norway" />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #080807;
		color: #f3efe6;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background:
			radial-gradient(circle at 20% 10%, rgba(196, 166, 105, 0.12), transparent 28rem),
			linear-gradient(135deg, #050505 0%, #12100d 48%, #070707 100%);
		color: #f3efe6;
		letter-spacing: -0.01em;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 10;
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem clamp(1.25rem, 4vw, 4rem);
		background: linear-gradient(to bottom, rgba(5, 5, 5, 0.82), transparent);
		backdrop-filter: blur(18px);
	}

	.brand {
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}

	nav {
		display: flex;
		gap: clamp(1rem, 3vw, 2.5rem);
		color: rgba(243, 239, 230, 0.62);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	nav a {
		transition: color 180ms ease;
	}

	nav a:hover {
		color: #f3efe6;
	}

	main {
		overflow: hidden;
	}

	.hero,
	.section {
		width: min(100% - 2.5rem, 1180px);
		margin: 0 auto;
	}

	.hero {
		display: grid;
		min-height: 100vh;
		align-content: center;
		padding: 9rem 0 5rem;
	}

	.eyebrow {
		margin: 0 0 1.5rem;
		color: #c4a669;
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 900px;
		margin-bottom: 1.75rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.8rem, 9vw, 8.5rem);
		font-weight: 400;
		line-height: 0.92;
		letter-spacing: -0.075em;
	}

	h2 {
		margin-bottom: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.4rem, 5vw, 5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.055em;
	}

	h3 {
		margin-bottom: 0.9rem;
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: 0.03em;
	}

	.intro {
		max-width: 720px;
		margin-bottom: 2.5rem;
		color: rgba(243, 239, 230, 0.68);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.75;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		color: rgba(243, 239, 230, 0.45);
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3.6rem;
		padding: 0 1.6rem;
		border: 1px solid rgba(196, 166, 105, 0.52);
		background: rgba(196, 166, 105, 0.08);
		color: #f7e6bd;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		transition:
			border-color 180ms ease,
			background 180ms ease,
			transform 180ms ease;
	}

	.button:hover {
		border-color: rgba(247, 230, 189, 0.9);
		background: rgba(196, 166, 105, 0.15);
		transform: translateY(-1px);
	}

	.section {
		padding: clamp(5rem, 12vw, 9rem) 0;
		border-top: 1px solid rgba(243, 239, 230, 0.09);
	}

	.split {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}

	.panel-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.panel-grid article {
		min-height: 11rem;
		padding: 1.4rem;
		border: 1px solid rgba(243, 239, 230, 0.09);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
			rgba(255, 255, 255, 0.015);
		color: rgba(243, 239, 230, 0.78);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.35rem;
		line-height: 1.15;
	}

	.statement p {
		max-width: 980px;
		margin-bottom: 0;
		color: rgba(243, 239, 230, 0.82);
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2rem, 4.5vw, 4.4rem);
		line-height: 1.06;
		letter-spacing: -0.055em;
	}

	.proof {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.proof div {
		padding: 2rem;
		border-left: 1px solid rgba(196, 166, 105, 0.35);
	}

	.proof span {
		display: block;
		margin-bottom: 4rem;
		color: rgba(196, 166, 105, 0.72);
		font-size: 0.75rem;
		letter-spacing: 0.18em;
	}

	.proof p,
	.contact p {
		color: rgba(243, 239, 230, 0.6);
		line-height: 1.75;
	}

	.contact-wrapper {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(3rem, 8vw, 6rem);
		align-items: start;
	}

	.contact {
		max-width: none;
		text-align: left;
	}

	.contact h2 {
		margin-bottom: 1.5rem;
	}

	.contact p {
		margin-bottom: 2.3rem;
		font-size: 1.1rem;
	}

	footer {
		width: min(100% - 2.5rem, 1180px);
		margin: 0 auto;
		padding: 2rem 0 3rem;
		border-top: 1px solid rgba(243, 239, 230, 0.09);
		color: rgba(243, 239, 230, 0.36);
		font-size: 0.85rem;
	}

	@media (max-width: 760px) {
		.site-header {
			position: absolute;
			align-items: flex-start;
			gap: 1rem;
		}

		nav {
			display: none;
		}

		.hero {
			min-height: auto;
			padding-top: 8rem;
		}

		.split,
		.proof,
		.contact-wrapper {
			grid-template-columns: 1fr;
		}

		.panel-grid {
			grid-template-columns: 1fr;
		}

		.proof span {
			margin-bottom: 2rem;
		}

		.contact {
			text-align: center;
		}

		.contact h2,
		.contact p {
			text-align: center;
		}
	}
</style>
