---
// Root entry point. The real site lives under /no/ and /en/.
// This is a static redirect page: Apache also 302s "/" to "/no/" (see public/.htaccess),
// but this file guarantees a working landing page even if the rewrite is unavailable.
import { DEFAULT_LANGUAGE } from "../utils/i18n";

const target = `/${DEFAULT_LANGUAGE}/`;
---

<!doctype html>
<html lang={DEFAULT_LANGUAGE}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={`https://entrynor.no${target}`} />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<meta name="robots" content="noindex, follow" />
		<title>Entrynor</title>
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				background: #080807;
				color: #f3efe6;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
			}
			a {
				color: #c4a669;
			}
		</style>
	</head>
	<body>
		<p>Videresender til <a href={target}>entrynor.no{target}</a>…</p>
		<script is:inline define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</body>
</html>
