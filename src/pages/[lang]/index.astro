---
import type { Language } from "../../utils/i18n";
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE, getTranslation, isValidLanguage, CONTACT_EMAIL, COMPANY_NAME, COMPANY_ADDRESS } from "../../utils/i18n";
import ContactFormI18n from "../../components/ContactFormI18n.astro";
import FooterI18n from "../../components/FooterI18n.astro";
import Logo from "../../components/Logo.astro";
import ProductShowcase from "../../components/ProductShowcase.astro";

export const prerender = true;

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

interface Props {
  lang: string;
}

const { lang: langParam } = Astro.props as Props;
let lang: Language = DEFAULT_LANGUAGE;

if (isValidLanguage(langParam)) {
  lang = langParam;
}

const t = (key: keyof typeof import("../../utils/i18n").translations.no) => getTranslation(lang, key);

const capabilities = [
  t("capability1"),
  t("capability2"),
  t("capability3"),
  t("capability4"),
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={lang === "no" 
        ? "Entrynor er en premiumproduksjonsleverandør for ambisiøse merkevarer." 
        : "Entrynor is a premium supplier and manufacturing partner for ambitious brands."}
    />
    <title>{lang === "no" ? "Entrynor — Premium produksjonsleverandør" : "Entrynor — Premium Manufacturing Partner"}</title>
  </head>
  <body>
    <header class="site-header">
      <Logo href={`/${lang}`} />
      <nav aria-label="Primary navigation">
        <a href={`#capabilities`}>{t("capabilities")}</a>
        <a href={`#standard`}>{t("standard")}</a>
        <a href={`#contact`}>{t("contact")}</a>
        <!-- Language Switcher -->
        <div class="language-switcher">
          {lang === "no" ? (
            <span class="lang-current">NO</span>
          ) : (
            <a href="/no" class="lang-link">NO</a>
          )}
          <span class="lang-divider">/</span>
          {lang === "en" ? (
            <span class="lang-current">EN</span>
          ) : (
            <a href="/en" class="lang-link">EN</a>
          )}
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">{t("tagline")}</p>
        <h1>{t("heroTitle")}</h1>
        <p class="intro">{t("heroDescription")}</p>
        <div class="hero-actions">
          <a class="button" href={`#contact`}>{t("startConversation")}</a>
          <span>{t("discreetByDesign")}</span>
        </div>
      </section>

      <section class="section proof">
        <div>
          <h3>{t("selective")}</h3>
          <p>{t("selectiveDesc")}</p>
        </div>
        <div>
          <h3>{t("controlled")}</h3>
          <p>{t("controlledDesc")}</p>
        </div>
        <div>
          <h3>{t("confidential")}</h3>
          <p>{t("confidentialDesc")}</p>
        </div>
      </section>

      <section id="contact" class="section contact">
        <div class="contact-wrapper">
          <div>
            <p class="eyebrow">{t("privateInquiries")}</p>
            <h2>{t("forBrands")}</h2>
            <p>{t("tellUs")}</p>
          </div>
          <ContactFormI18n lang={lang} />
        </div>
      </section>
    </main>

    <FooterI18n lang={lang} email={CONTACT_EMAIL} address={COMPANY_ADDRESS} />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #080807;
    color: #f3efe6;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at 20% 10%, rgba(196, 166, 105, 0.12), transparent 28rem),
      linear-gradient(135deg, #050505 0%, #12100d 48%, #070707 100%);
    color: #f3efe6;
    letter-spacing: -0.01em;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1.25rem, 4vw, 4rem);
    background: linear-gradient(to bottom, rgba(5, 5, 5, 0.82), transparent);
    backdrop-filter: blur(18px);
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
    color: rgba(243, 239, 230, 0.62);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    align-items: center;
  }

  nav a {
    transition: color 180ms ease;
  }

  nav a:hover {
    color: #f3efe6;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 1rem;
    padding-left: 1rem;
    border-left: 1px solid rgba(243, 239, 230, 0.2);
  }

  .lang-current {
    color: rgba(196, 166, 105, 0.8);
    font-weight: 600;
    font-size: 0.7rem;
  }

  .lang-link {
    color: rgba(243, 239, 230, 0.5);
    font-size: 0.7rem;
    transition: color 180ms ease;
  }

  .lang-link:hover {
    color: rgba(243, 239, 230, 0.8);
  }

  .lang-divider {
    color: rgba(243, 239, 230, 0.3);
    font-size: 0.7rem;
  }

  main {
    overflow: hidden;
  }

  .hero,
  .section {
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto;
  }

  .hero {
    display: grid;
    min-height: auto;
    align-content: start;
    padding: 10rem 0 5rem;
  }

  .eyebrow {
    padding-top: 0;
    margin: 0 0 1.5rem;
    color: #c4a669;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 900px;
    margin-bottom: 1.75rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: rgba(243, 239, 230, 0.95);
  }

  h2 {
    margin-bottom: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: rgba(243, 239, 230, 0.9);
  }

  h3 {
    margin-bottom: 0.9rem;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: rgba(243, 239, 230, 0.85);
  }

  .intro {
    max-width: 720px;
    margin-bottom: 1.5rem;
    color: rgba(243, 239, 230, 0.68);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    color: rgba(243, 239, 230, 0.45);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.6rem;
    padding: 0 1.6rem;
    border: 1px solid rgba(196, 166, 105, 0.52);
    background: rgba(196, 166, 105, 0.08);
    color: #f7e6bd;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .button:hover {
    border-color: rgba(247, 230, 189, 0.9);
    background: rgba(196, 166, 105, 0.15);
    transform: translateY(-1px);
  }

  .section {
    padding: 5rem 0 clamp(5rem, 12vw, 9rem);
    border-top: 1px solid rgba(243, 239, 230, 0.09);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .panel-grid article {
    min-height: 11rem;
    padding: 1.4rem;
    border: 1px solid rgba(243, 239, 230, 0.09);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
      rgba(255, 255, 255, 0.015);
    color: rgba(243, 239, 230, 0.78);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .statement p {
    max-width: 980px;
    margin-bottom: 0;
    color: rgba(243, 239, 230, 0.72);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: -0.01em;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(3rem, 6vw, 5rem);
    position: relative;
  }

  .proof::before {
    content: '';
    position: absolute;
    right: -10%;
    bottom: -10%;
    width: 500px;
    height: 500px;
    background-image: url('/images/wooden-cards.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
  }

  .proof div {
    position: relative;
    z-index: 1;
    padding: 0;
  }

  .proof h3 {
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    font-size: clamp(0.85rem, 1.8vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #c4a669;
    text-transform: uppercase;
  }

  .proof p {
    color: #c4a669;
    font-size: clamp(0.85rem, 1.8vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.8;
    margin: 0;
  }

  .contact p {
    color: rgba(243, 239, 230, 0.6);
    line-height: 1.75;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(3rem, 8vw, 6rem);
    align-items: start;
  }

  .contact {
    max-width: none;
    text-align: left;
  }

  .contact h2 {
    margin-bottom: 1.5rem;
  }

  .contact p {
    margin-bottom: 2.3rem;
    font-size: 1.1rem;
  }

  @media (max-width: 760px) {
    .site-header {
      position: absolute;
      align-items: flex-start;
      gap: 1rem;
    }

    nav {
      display: none;
    }

    .hero {
      min-height: auto;
      padding-top: 8rem;
    }

    .split,
    .proof,
    .contact-wrapper {
      grid-template-columns: 1fr;
    }

    .panel-grid {
      grid-template-columns: 1fr;
    }

    .proof span {
      margin-bottom: 2rem;
    }

    .contact {
      text-align: center;
    }

    .contact h2,
    .contact p {
      text-align: center;
    }
  }
</style>
