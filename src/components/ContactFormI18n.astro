---
import type { Language } from "../utils/i18n";
import { getTranslation, CONTACT_EMAIL } from "../utils/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || "6Ler10QnAAAAAHPMsiNc97HAUkoLyOx9Bzm594Db";

const t = (key: keyof typeof import("../utils/i18n").translations.no) => getTranslation(lang, key);
---

<!-- reCAPTCHA v3 Script -->
<script src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`} async defer></script>

<!-- Contact form (now hosted on Vercel serverless function) -->
<form class="contact-form" id="contactForm" method="POST" action="/api/contact-form" data-email={CONTACT_EMAIL} data-recaptcha-site-key={RECAPTCHA_SITE_KEY} novalidate>
	<div class="form-group">
		<label for="name">{t("yourName")}</label>
		<input
			type="text"
			id="name"
			name="name"
			placeholder={t("fullName")}
			pattern="[A-Za-zÀ-ÖØ-öø-ÿ][A-Za-zÀ-ÖØ-öø-ÿ' .\-]{1,59}"
			maxlength="60"
			required
			aria-required="true"
		/>
		<span class="error-message" data-field="name">{lang === "no" ? "Skriv inn et gyldig navn (kun bokstaver)" : "Enter a valid name (letters only)"}</span>
	</div>

	<div class="form-group">
		<label for="phone">{t("phone")}</label>
		<input
			type="tel"
			id="phone"
			name="phone"
			placeholder={t("phonePlaceholder")}
			pattern="[+]?[0-9][0-9 ()\-]{6,18}"
			maxlength="20"
			inputmode="tel"
			required
			aria-required="true"
		/>
		<span class="error-message" data-field="phone">{lang === "no" ? "Skriv inn et gyldig telefonnummer (kun tall, + og mellomrom)" : "Enter a valid phone number (digits, + and spaces only)"}</span>
	</div>

	<div class="form-group">
		<label for="email">{t("email")}</label>
		<input
			type="email"
			id="email"
			name="email"
			placeholder={t("emailPlaceholder")}
			required
			aria-required="true"
		/>
		<span class="error-message" data-field="email">{t("email")} er påkrevd</span>
	</div>

	<div class="form-group">
		<label for="message">{t("tellUsAboutProject")}</label>
		<textarea
			id="message"
			name="message"
			placeholder={t("projectPlaceholder")}
				rows="2"
				required
			aria-required="true"
		></textarea>
		<span class="error-message" data-field="message">{t("tellUsAboutProject")} er påkrevd</span>
	</div>

	<button type="submit" class="submit-button">{t("privacy")}</button>
	<p class="form-notice">{t("formNotice")}</p>
	<!-- Kept last so they don't shift :nth-child grid placement of the fields above -->
	<input type="hidden" id="recaptchaToken" name="recaptchaToken" />
	<!-- Honeypot: invisible to humans, bots fill it and get silently dropped -->
	<div class="hp-field" aria-hidden="true">
		<label for="company">Company</label>
		<input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
	</div>
</form>

<style>
	/* Honeypot: visually hidden but present for bots */
	.hp-field {
		position: absolute !important;
		left: -9999px !important;
		top: auto !important;
		width: 1px !important;
		height: 1px !important;
		overflow: hidden !important;
	}

	.contact-form {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 1.5rem;
		width: 100%;
		align-items: end;
	}

	input[type="hidden"] {
		display: none;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.form-group.checkbox {
		flex-direction: row;
		align-items: flex-start;
		gap: 0.75rem;
	}

	label {
		font-size: 0.8rem;
		font-weight: 600;
		color: #f3efe6;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-family: inherit;
	}

	.form-group.checkbox label {
		font-weight: 400;
		font-size: 0.9rem;
		line-height: 1.5;
		margin-top: 0.2rem;
		color: rgba(243, 239, 230, 0.8);
	}

	input[type="text"],
	input[type="email"],
	input[type="tel"],
	textarea {
		padding: 0.9rem 1rem;
		border: 1px solid rgba(243, 239, 230, 0.15);
		background: rgba(255, 255, 255, 0.03);
		color: #f3efe6;
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		border-radius: 2px;
		transition:
			border-color 180ms ease,
			background 180ms ease,
			box-shadow 180ms ease;
	}

	input[type="text"]:focus,
	input[type="email"]:focus,
	input[type="tel"]:focus,
	textarea:focus {
		outline: none;
		border-color: rgba(196, 166, 105, 0.6);
		background: rgba(255, 255, 255, 0.05);
		box-shadow: 0 0 0 3px rgba(196, 166, 105, 0.1);
	}

	textarea {
		resize: vertical;
		min-height: 60px;
		font-family: inherit;
		line-height: 1.6;
	}

	input[type="checkbox"] {
		width: 18px;
		height: 18px;
		margin-top: 3px;
		accent-color: rgba(196, 166, 105, 0.7);
		cursor: pointer;
	}

	.form-group:nth-child(4),
	.submit-button,
	.form-notice {
		grid-column: 1 / -1;
	}

	.submit-button {
		min-height: 3.2rem;
		padding: 0 1.6rem;
		margin-top: 1rem;
		border: 1px solid rgba(196, 166, 105, 0.52);
		background: rgba(196, 166, 105, 0.08);
		color: #f7e6bd;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		cursor: pointer;
		border-radius: 2px;
		transition:
			border-color 180ms ease,
			background 180ms ease,
			transform 180ms ease;
		font-family: inherit;
	}

	.submit-button:hover {
		border-color: rgba(247, 230, 189, 0.9);
		background: rgba(196, 166, 105, 0.15);
		transform: translateY(-1px);
	}

	.submit-button:active {
		transform: translateY(0);
	}

	.submit-button.success {
		background: #c4a669;
		border-color: #c4a669;
		color: #ffffff;
	}

	.form-notice {
		font-size: 0.8rem;
		color: rgba(243, 239, 230, 0.45);
		margin: 0;
		text-align: center;
		letter-spacing: 0.02em;
	}

	input.has-error,
	textarea.has-error {
		border-color: rgba(196, 166, 105, 0.6);
	}

	input.has-error:focus,
	textarea.has-error:focus {
		border-color: rgba(196, 166, 105, 0.8);
		box-shadow: 0 0 0 3px rgba(196, 166, 105, 0.15);
	}

	.form-group.has-error .error-message {
		display: block;
		font-size: 0.75rem;
		color: rgba(196, 166, 105, 0.7);
		margin-top: 0.3rem;
		letter-spacing: 0.01em;
	}

	.error-message {
		display: none;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.contact-form {
			grid-template-columns: 1fr 1fr 1fr;
		}
	}

	@media (max-width: 600px) {
		.contact-form {
			grid-template-columns: 1fr;
			gap: 1.2rem;
		}

		.form-group:nth-child(n+3),
		.submit-button,
		.form-notice {
			grid-column: 1;
		}

		input[type="text"],
		input[type="email"],
		input[type="tel"],
		textarea {
			font-size: 16px; /* Prevents iOS zoom on input */
		}
	}
</style>

<script>
	const form = document.getElementById("contactForm");

	if (form) {
		const inputs = form.querySelectorAll('input[required], textarea[required]');
		inputs.forEach(input => {
			input.addEventListener('invalid', (e) => {
				e.preventDefault();
			}, true);
			input.addEventListener('input', () => {
				input.classList.remove('has-error');
				input.parentElement?.classList.remove('has-error');
			});

			input.addEventListener('focus', () => {
				input.classList.remove('has-error');
				input.parentElement?.classList.remove('has-error');
			});
		});

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			// Manual validation
			let isValid = true;
			inputs.forEach(input => {
				if (!input.checkValidity()) {
					isValid = false;
					input.classList.add('has-error');
					input.parentElement?.classList.add('has-error');
				}
			});
			if (!isValid) {
				return;
			}

			const formData = new FormData(form);
			const data = Object.fromEntries(formData) as any;

			// Execute reCAPTCHA v3 (graceful fallback: form still works if unavailable)
			try {
				const siteKey = form.getAttribute("data-recaptcha-site-key");
				const grecaptcha = (window as any).grecaptcha;
				if (siteKey && grecaptcha) {
					await new Promise<void>((resolve) => grecaptcha.ready(() => resolve()));
					data.recaptchaToken = await grecaptcha.execute(siteKey, { action: "contact" });
				}
			} catch (recaptchaError) {
				console.warn("reCAPTCHA unavailable:", recaptchaError);
			}

			try {
				const response = await fetch(form.getAttribute("action") || "/api/contact", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify(data),
				});

				if (response.ok) {
					// Show success message
					const submitButton = form.querySelector(".submit-button") as HTMLButtonElement;
					const originalText = submitButton.textContent;
					const successText = document.documentElement.lang === "no" ? "Melding sendt" : "Message Sent";
					
					submitButton.textContent = successText;
					submitButton.disabled = true;
					submitButton.classList.add('success');

					// Reset form
					form.reset();
					inputs.forEach(input => {
						input.classList.remove('has-error');
						input.parentElement?.classList.remove('has-error');
					});

					// Reset button after 10 seconds
					setTimeout(() => {
						submitButton.textContent = originalText;
						submitButton.disabled = false;
						submitButton.classList.remove('success');
					}, 10000);
				} else {
					const errorData = await response.json().catch(() => ({}));
					console.error('Form submission failed:', errorData);
					alert(
						document.documentElement.lang === "no"
							? "Det oppstod en feil ved sending av meldingen. Vennligst prøv igjen."
							: "There was an error sending your message. Please try again."
					);
				}
			} catch (error) {
				console.error("Form submission error:", error);
				alert(
					document.documentElement.lang === "no"
						? "Det oppstod en feil ved sending av meldingen. Vennligst prøv igjen."
						: "There was an error sending your message. Please try again."
				);
			}
		});
	}
</script>
