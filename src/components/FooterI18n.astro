---
import type { Language } from "../utils/i18n";
import { getTranslation, COMPANY_NAME } from "../utils/i18n";
import CertificationSection from "./CertificationSection.astro";

interface Props {
  lang: Language;
  email?: string;
  address?: string;
}

const { 
  lang,
  email = "contact@entrynor.no",
  address = "Norway"
} = Astro.props;

const t = (key: keyof typeof import("../utils/i18n").translations.no) => getTranslation(lang, key);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Company Name & Address -->
      <div class="footer-section footer-center">
        <h3>{COMPANY_NAME}</h3>
        <p>{address}</p>
        <button class="privacy-link-footer" id="privacyBtnFooter">{lang === "no" ? "Personvern" : "Privacy"}</button>
      </div>

      <!-- Certifications -->
      <div class="footer-section footer-certifications">
        <p class="cert-title">{lang === "no" ? "Sammen med våre partnere har vi din rygg" : "Together with our partners we have your back"}</p>
        <div class="certifications-row">
          <span class="cert-badge">ISO 45001</span>
          <span class="cert-badge">ISO 14001</span>
          <span class="cert-badge">ISO 9001</span>
          <span class="cert-badge">RoHS</span>
          <span class="cert-badge">REACH</span>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
    </div>

    <!-- Privacy Modal -->
    <div class="privacy-modal" id="privacyModal">
      <div class="privacy-modal-content">
        <button class="privacy-close" id="closePrivacy">&times;</button>
        <h2>{lang === "no" ? "Personvern" : "Privacy"}</h2>
        <div class="privacy-text">
          {lang === "no" ? (
            <>
              <p><strong>ENTRYNOR AS</strong></p>
              <p>Org nr 830 589 902<br/>Etablert 2014</p>
              <p><strong>Behandling av personopplysninger</strong></p>
              <p>Vi behandler og beskytter dine personopplysninger i samsvar med GDPR og norsk personopplysningsloven.</p>
              <p><strong>Lagring av data</strong></p>
              <p>Dine kundeoplysninger lagres kun i følgende systemer:</p>
              <ul>
                <li>Vårt ERP-system (Enterprise Resource Planning)</li>
                <li>Våre fraktpartnere for ordre og leveringer</li>
                <li>Microsoft 365 for kommunikasjon (beskyttet med sikkerhetstiltak for din sikkerhet)</li>
              </ul>
              <p><strong>Vi deler ikke dine data</strong></p>
              <p>Vi deler aldri dine personopplysninger med tredjepart uten ditt samtykke, unntatt hvor det er lovpålagt.</p>
              <p><strong>Retten til å bli glemt</strong></p>
              <p>Du har rett til å bli slettet fra våre systemer i henhold til GDPR artikkel 17. Send en forespørsel via kontaktskjemaet vårt, og vi vil slette alle spor av dine personopplysninger innenfor de lovmessige forpliktelsene etter GDPR. Noen data kan bli beholdt hvis de er påkrevd av norsk lov (for eksempel regnskapsoppgjørelser).</p>
              <p><strong>Kontakt oss</strong></p>
              <p>Har du spørsmål om personvern eller ønsker å angi en slettingsforespørsel, kontakt oss via kontaktskjemaet.</p>
              <p><strong>Besøk oss</strong></p>
              <p>Vi holder til på Hvalstad i Asker. Du er varmt velkommen å besøke oss!</p>
            </>
          ) : (
            <>
              <p><strong>ENTRYNOR AS</strong></p>
              <p>Org nr 830 589 902<br/>Established 2014</p>
              <p><strong>Processing of Personal Information</strong></p>
              <p>We process and protect your personal information in accordance with GDPR and Norwegian data protection legislation.</p>
              <p><strong>Data Storage</strong></p>
              <p>Your customer information is stored only in the following systems:</p>
              <ul>
                <li>Our ERP system (Enterprise Resource Planning)</li>
                <li>Our shipping partners for orders and deliveries</li>
                <li>Microsoft 365 for communication (protected with security measures for your safety)</li>
              </ul>
              <p><strong>We Do Not Share Your Data</strong></p>
              <p>We never share your personal information with third parties without your consent, except where required by law.</p>
              <p><strong>Right to Be Forgotten</strong></p>
              <p>You have the right to be deleted from our systems under GDPR Article 17. Submit a request via our contact form, and we will delete all traces of your personal information within the legal obligations of GDPR. Some data may be retained if required by Norwegian law (for example, accounting records).</p>
              <p><strong>Contact Us</strong></p>
              <p>If you have any questions about privacy or wish to submit a deletion request, contact us via our contact form.</p>
              <p><strong>Visit Us</strong></p>
              <p>We are located in Hvalstad in Asker. You are warmly welcome to visit us!</p>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.4), rgba(5, 5, 5, 0.8));
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .footer-container {
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 0;
    text-align: center;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-center p {
    color: rgba(243, 239, 230, 0.5);
    font-size: 0.7rem;
    line-height: 1.5;
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 400;
  }

  h3 {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c4a669;
    margin: 0;
  }

  h4 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.7);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    justify-content: center;
  }

  .footer-links a {
    color: rgba(243, 239, 230, 0.55);
    font-size: 0.9rem;
    transition: color 180ms ease;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: rgba(196, 166, 105, 0.8);
  }

  .footer-links li {
    color: rgba(243, 239, 230, 0.55);
    font-size: 0.9rem;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.75rem 0 1rem;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(243, 239, 230, 0.36);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .footer-tagline {
    color: rgba(243, 239, 230, 0.25) !important;
    font-size: 0.8rem !important;
  }

  .footer-certification {
    padding: 0.75rem 0;
  }

  .footer-certification :global(.certification-section) {
    padding: 0;
    border-top: none;
    margin: 0;
  }

  .footer-certification :global(.certification-badge img) {
    width: clamp(84px, 14vw, 140px) !important;
  }

  .privacy-link-footer {
    background-color: #c4a669;
    color: #080807;
    border: none;
    padding: 0.6rem 1.2rem;
    margin-top: 1rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .privacy-link-footer:hover {
    background-color: #d4b679;
    transform: translateY(-1px);
  }

  .footer-certifications {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cert-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.5);
    margin: 0;
  }

  .certifications-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
  }

  .cert-badge {
    font-size: 1rem;
    color: #c4a669;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .privacy-modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    overflow: auto;
  }

  .privacy-modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .privacy-modal-content {
    background-color: #080807;
    padding: 2rem;
    border: 1px solid rgba(196, 166, 105, 0.3);
    border-radius: 4px;
    width: 90%;
    max-width: 700px;
    max-height: 80vh;
    overflow-y: auto;
    position: relative;
  }

  .privacy-modal-content h2 {
    margin-top: 0;
    color: #f3efe6;
    font-size: 1.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .privacy-modal-content p {
    color: rgba(243, 239, 230, 0.7);
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .privacy-modal-content ul {
    color: rgba(243, 239, 230, 0.7);
    margin-left: 1.5rem;
    line-height: 1.8;
    font-size: 0.9rem;
  }

  .privacy-modal-content li {
    margin-bottom: 0.5rem;
  }

  .privacy-modal-content strong {
    color: rgba(243, 239, 230, 0.9);
    font-weight: 600;
  }

  .privacy-close {
    color: rgba(243, 239, 230, 0.6);
    float: right;
    font-size: 2rem;
    font-weight: bold;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    line-height: 1;
    transition: color 180ms ease;
  }

  .privacy-close:hover {
    color: #f3efe6;
  }

  /* Responsive */
  @media (max-width: 760px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.5rem 0;
    }

    .footer-bottom {
      padding: 1.5rem 0 2rem;
    }

    h3 {
      font-size: 1rem;
    }

    h4 {
      font-size: 0.8rem;
    }

    .footer-links {
      gap: 0.6rem;
    }

    .footer-links a,
    .footer-links li {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .footer-content {
      gap: 1.5rem;
      padding: 1.5rem 0;
    }

    .footer-bottom {
      gap: 0.25rem;
      padding: 1rem 0 1.5rem;
    }

    .footer-bottom p {
      font-size: 0.75rem;
    }

    .privacy-modal-content {
      width: 95%;
      padding: 1.5rem;
    }
  }
</style>

<script>
  const privacyBtn = document.getElementById('privacyBtnFooter');
  const privacyModal = document.getElementById('privacyModal');
  const closePrivacy = document.getElementById('closePrivacy');

  if (privacyBtn && privacyModal && closePrivacy) {
    privacyBtn.addEventListener('click', () => {
      privacyModal.classList.add('active');
    });

    closePrivacy.addEventListener('click', () => {
      privacyModal.classList.remove('active');
    });

    window.addEventListener('click', (event) => {
      if (event.target === privacyModal) {
        privacyModal.classList.remove('active');
      }
    });
  }
</script>
