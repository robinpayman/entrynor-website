---
import type { Language } from "../utils/i18n";
import { getTranslation, COMPANY_NAME } from "../utils/i18n";
import CertificationSection from "./CertificationSection.astro";

interface Props {
  lang: Language;
  email?: string;
  address?: string;
}

const { 
  lang,
  email = "contact@entrynor.no",
  address = "Norway"
} = Astro.props;

const t = (key: keyof typeof import("../utils/i18n").translations.no) => getTranslation(lang, key);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Company Name & Address -->
      <div class="footer-section footer-center">
        <h3>{COMPANY_NAME}</h3>
        <p>{address}</p>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>{t("allRightsReserved").replace("{{year}}", year.toString())}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.4), rgba(5, 5, 5, 0.8));
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .footer-container {
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 0;
    text-align: center;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-center p {
    color: rgba(243, 239, 230, 0.62);
    font-size: 0.78rem;
    line-height: 1.5;
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f3efe6;
    margin: 0;
  }

  h4 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.7);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    justify-content: center;
  }

  .footer-links a {
    color: rgba(243, 239, 230, 0.55);
    font-size: 0.9rem;
    transition: color 180ms ease;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: rgba(196, 166, 105, 0.8);
  }

  .footer-links li {
    color: rgba(243, 239, 230, 0.55);
    font-size: 0.9rem;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.75rem 0 1rem;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(243, 239, 230, 0.36);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .footer-tagline {
    color: rgba(243, 239, 230, 0.25) !important;
    font-size: 0.8rem !important;
  }

  .footer-certification {
    padding: 0.75rem 0;
  }

  .footer-certification :global(.certification-section) {
    padding: 0;
    border-top: none;
    margin: 0;
  }

  .footer-certification :global(.certification-badge img) {
    width: clamp(84px, 14vw, 140px) !important;
  }

  /* Responsive */
  @media (max-width: 760px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.5rem 0;
    }

    .footer-bottom {
      padding: 1.5rem 0 2rem;
    }

    h3 {
      font-size: 1rem;
    }

    h4 {
      font-size: 0.8rem;
    }

    .footer-links {
      gap: 0.6rem;
    }

    .footer-links a,
    .footer-links li {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .footer-content {
      gap: 1.5rem;
      padding: 1.5rem 0;
    }

    .footer-bottom {
      gap: 0.25rem;
      padding: 1rem 0 1.5rem;
    }

    .footer-bottom p {
      font-size: 0.75rem;
    }
  }
</style>
