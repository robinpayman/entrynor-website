---
import type { Language } from "../utils/i18n";
import { getTranslation, COMPANY_NAME } from "../utils/i18n";
import CertificationSection from "./CertificationSection.astro";

interface Props {
  lang: Language;
  email?: string;
  address?: string;
}

const { 
  lang,
  email = "contact@entrynor.no",
  address = "Norway"
} = Astro.props;

const t = (key: keyof typeof import("../utils/i18n").translations.no) => getTranslation(lang, key);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Company Name & Address -->
      <div class="footer-section footer-center">
        <h3>{COMPANY_NAME}</h3>
        <p>{address}</p>
        <button class="personvern-btn" id="personvernBtn">
          {lang === "no" ? "Personvern" : "Privacy"}
        </button>
      </div>

      <!-- Certifications -->
      <div class="footer-section footer-certifications">
        <p class="cert-title">{lang === "no" ? "Sammen med våre partnere har vi din rygg" : "Together with our partners we have your back"}</p>
        <div class="certifications-row">
          <span class="cert-badge">ISO 45001</span>
          <span class="cert-badge">ISO 14001</span>
          <span class="cert-badge">ISO 9001</span>
          <span class="cert-badge">RoHS</span>
          <span class="cert-badge">REACH</span>
          <span class="cert-badge">FDA</span>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
    </div>
  </div>
</footer>

<!-- Privacy Modal -->
<div class="privacy-modal" id="privacyModal">
  <div class="modal-content">
    <button class="modal-close" id="modalClose">×</button>
    <div class="modal-body">
      <h3>ENTRYNOR AS</h3>
      <p>Org nr 830 589 902<br />Etablert 2014<br />Nye Vakås Vei 6, 1395 HVALSTAD</p>
      
      {lang === "no" ? (
        <>
          <h4>Personvern og GDPR</h4>
          <h5>Datalagring</h5>
          <p>Vi lagrer kundedata i vårt ERP-system, hos våre fraktpartnere og i Microsoft 365. All data behandles i henhold til GDPR.</p>
          
          <h5>Datadeling</h5>
          <p>Vi deler ikke persondata med tredjeparter uten eksplisitt samtykke fra deg. Data deles kun internt innenfor organisasjonen når nødvendig for ordrebehandling og levering.</p>
          
          <h5>Dine rettigheter</h5>
          <p>Du har rett til å bli glemt og få alle dine persondata slettet fra våre systemer (GDPR artikkel 17). Kontakt oss på info@entrynor.no for å utøve denne retten.</p>
        </>
      ) : (
        <>
          <h4>Privacy and GDPR</h4>
          <h5>Data Storage</h5>
          <p>We store customer data in our ERP system, with our shipping partners, and in Microsoft 365. All data is processed in accordance with GDPR.</p>
          
          <h5>Data Sharing</h5>
          <p>We do not share personal data with third parties without your explicit consent. Data is shared only internally within the organization when necessary for order processing and delivery.</p>
          
          <h5>Your Rights</h5>
          <p>You have the right to be forgotten and have all your personal data deleted from our systems (GDPR article 17). Contact us at info@entrynor.no to exercise this right.</p>
        </>
      )}
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('personvernBtn');
  const modal = document.getElementById('privacyModal');
  const closeBtn = document.getElementById('modalClose');

  if (btn && modal && closeBtn) {
    btn.addEventListener('click', () => {
      modal.classList.add('show');
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.remove('show');
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('show');
      }
    });
  }
</script>

<style>
  .site-footer {
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.4), rgba(5, 5, 5, 0.8));
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .footer-container {
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 0;
    text-align: center;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-center p {
    color: rgba(243, 239, 230, 0.5);
    font-size: 0.7rem;
    line-height: 1.5;
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  h3 {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c4a669;
    margin: 0;
  }

  h4 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.7);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    justify-content: center;
  }

  .footer-links a {
    color: rgba(243, 239, 230, 0.55);
    font-size: 0.9rem;
    transition: color 180ms ease;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: rgba(196, 166, 105, 0.8);
  }

  .footer-links li {
    color: rgba(243, 239, 230, 0.55);
    font-size: 0.9rem;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.75rem 0 1rem;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(243, 239, 230, 0.36);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .footer-tagline {
    color: rgba(243, 239, 230, 0.25) !important;
    font-size: 0.8rem !important;
  }

  .footer-certification {
    padding: 0.75rem 0;
  }

  .footer-certification :global(.certification-section) {
    padding: 0;
    border-top: none;
    margin: 0;
  }

  .footer-certification :global(.certification-badge img) {
    width: clamp(84px, 14vw, 140px) !important;
  }

  .personvern-btn {
    background-color: #c4a669;
    color: #080807;
    border: none;
    padding: 0.6rem 1.2rem;
    margin-top: 1rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .personvern-btn:hover {
    background-color: #d4b679;
    transform: translateY(-1px);
  }

  .footer-certifications {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cert-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.5);
    margin: 0;
  }

  .certifications-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
  }

  .cert-badge {
    font-size: 1rem;
    color: #c4a669;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .privacy-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .privacy-modal.show {
    display: flex;
  }

  .modal-content {
    background-color: #080807;
    border: 1px solid rgba(196, 166, 105, 0.3);
    padding: 2rem;
    max-width: 600px;
    max-height: 80vh;
    overflow-y: auto;
    position: relative;
    border-radius: 4px;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: rgba(243, 239, 230, 0.7);
    font-size: 1.8rem;
    cursor: pointer;
    padding: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 180ms ease;
  }

  .modal-close:hover {
    color: #f3efe6;
  }

  .modal-body h3 {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c4a669;
    margin: 0 0 0.5rem 0;
  }

  .modal-body h4 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.8);
    margin: 1.5rem 0 0.75rem 0;
  }

  .modal-body h5 {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4a669;
    margin: 1rem 0 0.5rem 0;
  }

  .modal-body p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(243, 239, 230, 0.7);
    margin: 0 0 1rem 0;
  }

  /* Responsive */
  @media (max-width: 760px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.5rem 0;
    }

    .footer-bottom {
      padding: 1.5rem 0 2rem;
    }

    h3 {
      font-size: 1rem;
    }

    h4 {
      font-size: 0.8rem;
    }

    .footer-links {
      gap: 0.6rem;
    }

    .footer-links a,
    .footer-links li {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .footer-content {
      gap: 1.5rem;
      padding: 1.5rem 0;
    }

    .footer-bottom {
      gap: 0.25rem;
      padding: 1rem 0 1.5rem;
    }

    .footer-bottom p {
      font-size: 0.75rem;
    }
  }
</style>
