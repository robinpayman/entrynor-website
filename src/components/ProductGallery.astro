---
interface Props {
  lang?: "no" | "en";
}

const { lang = "no" } = Astro.props;

const products = [
  { id: 1, name: "Wristband", image: "/images/products/ENTRYNOR_product_01.png" },
  { id: 2, name: "Wristband Navy", image: "/images/products/ENTRYNOR_product_02.png" },
  { id: 3, name: "Wristband Classic", image: "/images/products/ENTRYNOR_product_03.png" },
  { id: 4, name: "Wristband Taupe", image: "/images/products/ENTRYNOR_product_04.png" },
  { id: 5, name: "Mesh Bracelet", image: "/images/products/ENTRYNOR_product_05.png" },
  { id: 6, name: "Woven Bracelet", image: "/images/products/ENTRYNOR_product_06.png" },
  { id: 7, name: "Adjustable Band Navy", image: "/images/products/ENTRYNOR_product_07.png" },
  { id: 8, name: "Adjustable Band Green", image: "/images/products/ENTRYNOR_product_08.png" },
  { id: 9, name: "Watch", image: "/images/products/ENTRYNOR_product_09.png" },
  { id: 10, name: "Wooden Card", image: "/images/products/ENTRYNOR_product_10.png" },
  { id: 11, name: "Wooden Card Light", image: "/images/products/ENTRYNOR_product_11.png" },
  { id: 12, name: "Wooden Keychain", image: "/images/products/ENTRYNOR_product_12.png" },
];
---

<section class="product-gallery">
  <div class="gallery-container">
    <div class="gallery-intro">
      <p class="eyebrow">{lang === "no" ? "Produkter" : "Products"}</p>
      <h2>{lang === "no" ? "Premium RFID-løsninger" : "Premium RFID Solutions"}</h2>
      <p class="intro-text">
        {lang === "no" 
          ? "Håndvalgte materialer, presise detaljer, og diskret branding som gjenspeiler merkenes verdier."
          : "Hand-selected materials, precise details, and discreet branding that reflects brand values."}
      </p>
    </div>

    <div class="products-grid">
      {products.map((product) => (
        <div class="product-item">
          <img src={product.image} alt={product.name} class="product-image-only" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .product-gallery {
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto;
    padding: 5rem 0 clamp(5rem, 12vw, 9rem);
    border-top: 1px solid rgba(243, 239, 230, 0.09);
  }

  .gallery-container {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 8vw, 5rem);
  }

  .gallery-intro {
    max-width: 600px;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: #c4a669;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: rgba(243, 239, 230, 0.9);
  }

  .intro-text {
    margin: 0;
    color: rgba(243, 239, 230, 0.68);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
  }

  .product-item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-image-only {
    width: 100%;
    height: auto;
    object-fit: contain;
    aspect-ratio: 1;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .products-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
  }

  @media (max-width: 600px) {
    .product-gallery {
      padding: 3rem 0 clamp(3rem, 8vw, 5rem);
    }

    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .product-image {
      border-radius: 2px;
    }
  }
</style>
