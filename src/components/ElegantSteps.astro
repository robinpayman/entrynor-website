---
interface Props {
  lang?: "no" | "en";
}

const { lang = "no" } = Astro.props;

const steps = lang === "no" ? [] : [];
---

<div class="steps-container">
  {steps.map((step, index) => (
    <div class="step" key={index}>
      <div class="step-content">
        <h3 class="step-title">{step.title}</h3>
        <p class="step-description">{step.description}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .steps-container {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(4rem, 8vw, 8rem);
    position: relative;
    text-align: center;
  }

  .step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    position: relative;
    max-width: 400px;
  }


  .step-content {
    flex: 1;
    overflow: visible;
    position: relative;
  }


  .step-title {
    margin: 0 0 0.5rem 0;
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    font-weight: 600;
    color: rgba(243, 239, 230, 0.8);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .step-description {
    margin: 0;
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    font-weight: 400;
    color: rgba(243, 239, 230, 0.65);
    line-height: 1.6;
    letter-spacing: 0.02em;
  }


  /* Responsive */
  @media (max-width: 900px) {
    .steps-container {
      flex-direction: column;
      gap: 2.5rem;
    }

    .step {
      gap: 1.2rem;
    }

    .step-connector {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .steps-container {
      gap: 2rem;
    }

    .step {
      gap: 1rem;
    }

    .step-number {
      font-size: 1rem;
    }

    .step-title {
      font-size: 0.95rem;
    }

    .step-description {
      font-size: 0.85rem;
    }
  }
</style>
