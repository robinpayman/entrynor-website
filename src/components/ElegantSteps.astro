---
interface Props {
  lang?: "no" | "en";
}

const { lang = "no" } = Astro.props;

const steps = lang === "no" 
  ? [
      {
        title: "Kontakt",
        description: "",
      },
      {
        title: "Ekslusiv design & funksjonalitet",
        description: "Vi eier prosessen fra sikkerhet til design - du lener deg tilbake",
      },
      {
        title: "Levering",
        description: "Vi leverer til våre kunder globalt",
      },
    ]
  : [
      {
        title: "Contact",
        description: "",
      },
      {
        title: "Exclusive Design & Functionality",
        description: "We own the process from security to design - you lean back",
      },
      {
        title: "Delivery",
        description: "We deliver to our customers globally",
      },
    ];
---

<div class="steps-container">
  {steps.map((step, index) => (
    <>
      <div class="step">
        <div class="step-number">{index + 1}</div>
        <div class="step-content">
          <h3 class="step-title">{step.title}</h3>
          <p class="step-description">{step.description}</p>
        </div>
      </div>
    </>
  ))}
</div>

<style>
  .steps-container {
    display: flex;
    align-items: flex-start;
    gap: clamp(2rem, 5vw, 4rem);
    position: relative;
  }

  .step {
    flex: 1;
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    position: relative;
  }

  .step-number {
    width: clamp(32px, 6vw, 45px);
    height: clamp(32px, 6vw, 45px);
    min-width: clamp(32px, 6vw, 45px);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid rgba(196, 166, 105, 0.6);
    border-radius: 50%;
    font-weight: 600;
    color: rgba(196, 166, 105, 0.8);
    font-size: clamp(0.75rem, 1.5vw, 0.95rem);
  }

  .step-content {
    flex: 1;
    overflow: visible;
    position: relative;
  }


  .step-title {
    margin: 0 0 0.5rem 0;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    font-weight: 600;
    color: rgba(196, 166, 105, 0.9);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .step-description {
    margin: 0;
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: 400;
    color: rgba(243, 239, 230, 0.6);
    line-height: 1.5;
    letter-spacing: 0.01em;
  }


  /* Responsive */
  @media (max-width: 900px) {
    .steps-container {
      flex-direction: column;
      gap: 2.5rem;
    }

    .step {
      gap: 1.2rem;
    }

    .step-connector {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .steps-container {
      gap: 2rem;
    }

    .step {
      gap: 1rem;
    }

    .step-number {
      font-size: 1rem;
    }

    .step-title {
      font-size: 0.95rem;
    }

    .step-description {
      font-size: 0.85rem;
    }
  }
</style>
