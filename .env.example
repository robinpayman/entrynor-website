# Microsoft Graph API Configuration for Contact Form
# These are required for the contact form to send emails via Office 365

# Azure AD Tenant ID
# Get from: https://portal.azure.com > Azure AD > Properties > Tenant ID
EMAIL_GRAPH_TENANT_ID=your-tenant-id

# Azure AD Application (Client) ID
# Get from: https://portal.azure.com > Azure AD > App registrations > Your app > Application ID
EMAIL_GRAPH_CLIENT_ID=your-client-id

# Azure AD Client Secret
# Get from: https://portal.azure.com > Azure AD > App registrations > Your app > Certificates & secrets
# ⚠️ NEVER commit this to git - use .env.local for actual values
EMAIL_GRAPH_CLIENT_SECRET=your-client-secret

# Sender email address (Office 365 account that will send emails)
# This should be the email address of the account that owns the Azure AD app
EMAIL_GRAPH_SENDER=your-office365-email@domain.com

# Google reCAPTCHA v3 Configuration for Contact Form
# Get from: https://www.google.com/recaptcha/admin
# reCAPTCHA v3 Site Key (public key)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# reCAPTCHA v3 Secret Key (private key)
# ⚠️ NEVER commit this to git - use .env.local for actual values
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
